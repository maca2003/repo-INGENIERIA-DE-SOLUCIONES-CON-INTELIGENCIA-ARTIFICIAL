# Copiar como .env  (Windows: copy .env.example .env)  y ajustar.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).

# Proveedor de modelos: ollama (local, por defecto) o gemini (API gratuita)
AGENTE_PROVEEDOR=ollama

# --- Ollama (local) ---
AGENTE_MODELO_LLM=llama3.2:3b
AGENTE_MODELO_EMBEDDINGS=qwen3-embedding:0.6b

# --- Gemini (solo si AGENTE_PROVEEDOR=gemini) ---
# Obtener la clave en https://aistudio.google.com/apikey
GOOGLE_API_KEY=tu_api_key_aqui
# Si aparece "model not found", revisar https://ai.google.dev/gemini-api/docs/models
LLM_MODEL=gemini-3.8-flash
AGENTE_MODELO_EMBEDDINGS_GEMINI=models/gemini-embedding-001

# --- Comportamiento del agente ---
AGENTE_TEMPERATURA=0
AGENTE_FRAGMENTOS_RAG=4
# Calibrar con: python src/calibrar_umbral.py
AGENTE_UMBRAL_DISTANCIA_RAG=1.40
AGENTE_UMBRAL_DISTANCIA_MEMORIA=1.60
AGENTE_MAX_MENSAJES_HILO=12
AGENTE_MENSAJES_CONSERVADOS=6
AGENTE_MAX_PASOS_FLUJO=30
AGENTE_MAX_REINTENTOS=1
AGENTE_UMBRAL_DIFERENCIA_VALOR=0.05
# Fecha para priorizar la cola (vacío = hoy). Útil para la demo, ej. 2026-11-02
AGENTE_FECHA_REFERENCIA=

# --- Observabilidad y optimización (EP3) ---
# true: ruta directa, resumen sin LLM, keep_alive y precalentamiento. false: comportamiento EP2.
AGENTE_OPTIMIZADO=true
AGENTE_KEEP_ALIVE=30m
AGENTE_NUM_PREDICT=320
AGENTE_NUM_CTX=4096
AGENTE_OBSERVABILIDAD=true
AGENTE_RETENCION_LOGS_DIAS=30
AGENTE_MAX_LARGO_ENTRADA=1000
